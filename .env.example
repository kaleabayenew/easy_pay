# Server
PORT=3000
NODE_ENV=development

# Database (DB_PASSWORD is required — no default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_monitor
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here

# JWT (required — must be a long random string, never the default)
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRE=7d

# HMAC (required — used to verify requests from Android devices)
HMAC_SECRET=change_this_to_a_long_random_hmac_secret_before_deploying

# CORS
CORS_ORIGIN=*

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# Admin seed (required when running `npm run migrate` for the first time)
# ADMIN_SEED_PHONE defaults to +251900000000 if not set
# ADMIN_SEED_PIN must be set explicitly — no default is provided
ADMIN_SEED_PHONE=+251900000000
ADMIN_SEED_PIN=your_strong_admin_pin_here
